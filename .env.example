# Copiar para .env e preencher. Nunca commitar .env nem passwords reais.

# Compose local exige POSTGRES_* / S3_* / GARAGE_RPC_SECRET (sem defaults inseguros no compose).
POSTGRES_USER=vh
POSTGRES_PASSWORD=vhsecret
POSTGRES_DB=vh_team
COMPOSE_PROFILES=local

# Apps no host (pnpm dev): localhost. Em docker compose prod/smoke o entrypoint usa POSTGRES_HOST=postgres.
DATABASE_URL=postgresql://vh:vhsecret@localhost:5435/vh_team?schema=public
REDIS_URL=redis://localhost:6382

# Obrigatório em produção (min. 32 caracteres aleatórios)
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:3001

# Object storage — Garage local (perfil compose `local`).
# S3 API (presign/PUT): :3900 · Website público (GET anónimo): :3902
# Em compose (API no contentor): S3_ENDPOINT=http://garage:3900
# Produção R2: S3_PUBLIC_URL=https://pub-….r2.dev (sem /bucket no caminho) + CORS no bucket.
# Access key Garage = "GK" + 30 hex; secret = 64 hex. Gerar:
#   S3_ACCESS_KEY=GK$(openssl rand -hex 15)
#   S3_SECRET_KEY=$(openssl rand -hex 32)
#   GARAGE_RPC_SECRET=$(openssl rand -hex 32)
S3_ENDPOINT=http://localhost:3900
S3_PUBLIC_URL=http://vh-media.web.garage.localhost:3902
S3_REGION=garage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=vh-media
S3_FORCE_PATH_STYLE=true
# true só se o CDN/público usar /<bucket>/<key> (legado). R2 e Garage website: omitir/false.
# S3_PUBLIC_INCLUDE_BUCKET=false
# Obrigatório em produção: origens HTTPS do site (vírgula). Não usar *.
S3_CORS_ORIGINS=http://localhost:3000
S3_ENABLE_WEBSITE=true

NEXT_PUBLIC_S3_PUBLIC_URL=http://vh-media.web.garage.localhost:3902
NEXT_PUBLIC_S3_BUCKET=vh-media
# NEXT_PUBLIC_S3_INCLUDE_BUCKET=true
GARAGE_RPC_SECRET=

# SMTP — SMTP_SECURE=true para 465; false/omitido para STARTTLS (587)
# Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=resend SMTP_PASS=re_...
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vhteamfighters.pt
# Obrigatório em produção: email real confirmado com o cliente (não .local / example.com).
# Deixar vazio aqui — a verificação de produção rejeita se não estiver preenchido.
ENROLLMENT_NOTIFY_TO=

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Seed — obrigatórios; sem password por omissão no código (email válido RFC)
ADMIN_EMAIL=admin@vhteamfighters.pt
ADMIN_PASSWORD=
ADMIN_NAME=Admin VH

WEBAUTHN_RP_ID=localhost
