# Copiar para .env e preencher. Nunca commitar .env nem passwords reais.

DATABASE_URL=postgresql://vh:vhsecret@localhost:5435/vh_team?schema=public
REDIS_URL=redis://localhost:6382

# Obrigatório em produção (min. 32 caracteres aleatórios)
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:3001

# Object storage — em produção: S3/R2/Garage com URL HTTPS (não minioadmin)
S3_ENDPOINT=http://localhost:9014
S3_PUBLIC_URL=http://localhost:9014
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vh-media
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9014
NEXT_PUBLIC_S3_BUCKET=vh-media

# SMTP — SMTP_SECURE=true para 465; false/omitido para STARTTLS (587)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost
# Em produção: email real da equipa (não .local)
ENROLLMENT_NOTIFY_TO=

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Seed — obrigatórios; sem password por omissão no código
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=
ADMIN_NAME=Admin VH

WEBAUTHN_RP_ID=localhost

# Compose local (opcional)
POSTGRES_USER=vh
POSTGRES_PASSWORD=vhsecret
POSTGRES_DB=vh_team
COMPOSE_PROFILES=local
