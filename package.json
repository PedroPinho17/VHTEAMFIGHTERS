{
  "name": "vh-team-fighters",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --filter=@vh/api --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "smoke": "node scripts/smoke-check.mjs",
    "docker:up": "docker compose --profile local up -d",
    "docker:down": "docker compose --profile local down",
    "test": "pnpm --filter @vh/api test",
    "typecheck": "pnpm --filter @vh/api typecheck && pnpm --filter web exec tsc --noEmit",
    "env:sync": "node scripts/env-sync.mjs",
    "db:generate": "pnpm --filter @vh/database generate",
    "db:migrate": "pnpm env:sync && pnpm --filter @vh/database migrate:dev",
    "db:deploy": "pnpm env:sync && pnpm --filter @vh/database migrate:deploy",
    "db:seed": "pnpm --filter @vh/database seed",
    "db:studio": "pnpm env:sync && pnpm --filter @vh/database studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
